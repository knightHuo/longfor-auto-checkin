# Copying this file does not create authentication. Run python tools/manage.py init.
COMPOSE_PROJECT_NAME=longfor-auto-checkin
RELEASE_TAG=local
PANEL_PORT=8088
# manage.py chooses the current UID/GID on Linux, or 10001 when run as root.
PANEL_UID=10001
PANEL_GID=10001
LONGFOR_PUBLIC_ORIGIN=http://127.0.0.1:8088
LONGFOR_ROOT_PATH=
LONGFOR_SCHEDULE_ENABLED=0
PIP_INDEX_URL=https://pypi.org/simple
