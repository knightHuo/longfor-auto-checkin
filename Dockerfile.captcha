# Optional image. Default deployment continues to use Dockerfile without these tools.
ARG NODE_IMAGE=node:24-bookworm-slim
ARG PYTHON_IMAGE=python:3.11-slim-bookworm
FROM ${NODE_IMAGE} AS node-deps
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM ${PYTHON_IMAGE}
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    DATA_DIR=/data \
    LONGHU_CAPTCHA=off \
    LONGHU_CHROMIUM_PATH=/usr/bin/chromium \
    AUX_AUTH_FILE=/run/secrets/panel-auth.json \
    HOME=/tmp
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 panel && useradd --uid 10001 --gid panel --no-create-home panel
COPY --from=node-deps /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY requirements.txt requirements-captcha.txt ./
RUN pip install -i ${PIP_INDEX_URL} -r requirements.txt -r requirements-captcha.txt
COPY --from=node-deps /build/node_modules ./node_modules
COPY app ./app
COPY tools/captcha_browser.js tools/slider_match.py ./tools/
RUN mkdir -p /data && chown 10001:10001 /data
USER 10001:10001
VOLUME ["/data"]
EXPOSE 8000
HEALTHCHECK --interval=60s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=4)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
